# Read only by the db service (docker-compose.yml env_file). Copy to .env.db and
# chmod 600 .env.db. Generate each value with: openssl rand -hex 32
#
# Both values are applied only when the postgres data directory is first created.
# To rotate later, run ALTER ROLE ... PASSWORD inside the db container and update
# this file and the DATABASE_URL lines in .env to match.

# Bootstrap superuser 'pageslop', for admin work only; the app never uses it.
POSTGRES_PASSWORD=change-me
# Non-superuser role 'pageslop_app' that owns the database; created by
# docker/db-init/10-app-role.sh. Must match the password in .env DATABASE_URL.
PAGESLOP_DB_PASSWORD=change-me
