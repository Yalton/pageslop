# Copy to .env and chmod 600 .env, or run ./scripts/setup.sh to generate it.

# --- Required ---

# The app and worker connect as the non-superuser role pageslop_app. The password
# must match PAGESLOP_DB_PASSWORD in .env.db (see .env.db.example). Use a hex
# password (openssl rand -hex 32) so it is URL-safe.
DATABASE_URL=postgresql://pageslop_app:change-me@db:5432/pageslop
DATABASE_URL_DIRECT=postgresql://pageslop_app:change-me@db:5432/pageslop

# Public URL people open in the browser, with no trailing slash. Sign-in only works
# over HTTPS or on http://localhost, because the session cookie is Secure.
BETTER_AUTH_URL=http://localhost:3847

# Session and email-token signing secret, 32+ characters; the app refuses
# to start without it. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts stored Anthropic API keys (AES-256-GCM). 64 hex characters.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Header the app reads the client IP from for auth rate limiting. Set it to the
# header your reverse proxy overwrites (cf-connecting-ip behind Cloudflare,
# x-real-ip for a typical nginx setup). Comma-separate several. A multi-hop
# x-forwarded-for chain is only trusted when TRUSTED_PROXIES lists your proxy
# IPs or CIDR ranges. If the app port is reachable without such a proxy (for
# example PAGESLOP_BIND=0.0.0.0 with no proxy), set TRUSTED_IP_HEADER=none:
# clients could otherwise send a fake IP header and dodge sign-in rate limits.
TRUSTED_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=172.18.0.1

# --- Docker Compose ---

# Address and port the app is published on. The default 127.0.0.1 suits a reverse
# proxy on the same host; use 0.0.0.0 to listen on every interface.
# PAGESLOP_BIND=127.0.0.1
# PAGESLOP_PORT=3847

# --- Email (optional) ---

# Used for email verification and password reset. Leave SMTP_HOST empty to skip
# sending: the links are then written to the app log (docker compose logs app).
# Port 465 uses implicit TLS, other ports STARTTLS; override with SMTP_SECURE=true|false.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pageslop <noreply@example.com>

# --- Optional ---

# Sign-up switch. Set both to false to close registration on this instance.
# ALLOW_SIGNUP is enforced server-side (Better Auth disableSignUp).
# NEXT_PUBLIC_ALLOW_SIGNUP hides sign-up links in the UI; it is inlined at build time,
# so rebuild the app image after changing it.
ALLOW_SIGNUP=true
NEXT_PUBLIC_ALLOW_SIGNUP=true

# Contact address shown on the privacy and terms pages.
# CONTACT_EMAIL=you@example.com

# Optional: where the settings page links for extension setup docs. Defaults to the
# upstream README. Inlined at build time, like NEXT_PUBLIC_ALLOW_SIGNUP.
# NEXT_PUBLIC_EXTENSION_DOCS_URL=https://github.com/Yalton/pageslop#browser-extension

# Stash: inbox/read stashed links older than this many days are archived daily at 03:00 UTC (never deleted).
STASH_EXPIRE_DAYS=14

# Most links one user may have waiting to be fetched; saves beyond it get 429.
# Bookmark imports are exempt, but each user runs one import at a time.
# MAX_PENDING_LINKS=1000
