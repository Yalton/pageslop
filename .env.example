DATABASE_URL=postgresql://user:pass@db:5432/pageslop
DATABASE_URL_DIRECT=postgresql://user:pass@db:5432/pageslop
BETTER_AUTH_SECRET=generate-a-random-32-char-string
BETTER_AUTH_URL=https://pageslop.citreum.com
ENCRYPTION_KEY=generate-a-64-char-hex-string

# Zoho SMTP (email verification + password reset)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=your-zoho-email@yourdomain.com
SMTP_PASS=your-zoho-app-password
SMTP_FROM=Pageslop <your-zoho-email@yourdomain.com>

# Sign-up switch. Set both to false to close registration on this instance.
# ALLOW_SIGNUP is enforced server-side (Better Auth disableSignUp).
# NEXT_PUBLIC_ALLOW_SIGNUP hides sign-up links in the UI; it is inlined at build time,
# so rebuild the app image after changing it.
ALLOW_SIGNUP=true
NEXT_PUBLIC_ALLOW_SIGNUP=true

# Stash: inbox/read stashed links older than this many days are archived daily at 03:00 UTC (never deleted).
STASH_EXPIRE_DAYS=14
