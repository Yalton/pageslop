{
	"manifest_version": 3,
	"name": "Pageslop Tab Stash",
	"version": "0.3.1",
	"description": "Saves idle tabs to your own Pageslop server, then closes them.",
	"icons": {
		"48": "icons/icon.svg",
		"96": "icons/icon.svg"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "tab-stash@pageslop",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["browsingActivity"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"permissions": ["tabs", "alarms", "storage", "menus", "sessions"],
	"optional_host_permissions": ["*://*/*"],
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"action": {
		"default_title": "Pageslop Tab Stash",
		"default_popup": "popup.html",
		"default_icon": "icons/icon.svg"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
