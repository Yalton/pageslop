    "test": "vitest run",
    "test:watch": "vitest",
    "ext:run": "web-ext run --source-dir extension",
    "ext:lint": "web-ext lint --source-dir extension",
    "ext:build": "web-ext build --source-dir extension --overwrite-dest"
  },
