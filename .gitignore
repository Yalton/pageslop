# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# docker postgres data
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# web-ext build output
/web-ext-artifacts/

# web-ext sign upload tracking
/extension/.amo-upload-uuid

# local agent and editor tooling
/.claude/
/.serena/
/.superpowers/
/.worktrees/
/.beads/

# Local design-critique archives
.impeccable/
